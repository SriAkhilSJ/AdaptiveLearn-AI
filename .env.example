# Server-side AI provider configuration.
# Copy this file to .env and set a real key locally. Never use a VITE_ prefix.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Live audio tutor configuration (all keys remain in this server-side file).
# Use a LiveKit Cloud project URL or a reachable self-hosted LiveKit server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AUDIO_AGENT_NAME=adaptivelearn-audio-tutor
LOG_LEVEL=info

# Deepgram provides streaming speech recognition and voice synthesis.
# The existing AI_API_KEY / AI_BASE_URL / AI_MODEL above power the tutor's conversation.
DEEPGRAM_API_KEY=
AUDIO_STT_MODEL=nova-3
AUDIO_LANGUAGE=en
AUDIO_TTS_MODEL=aura-2-andromeda-en

# Comic panel illustrations (all keys remain in this server-side file).
# disabled (default): Visual mode shows the text storyboard only, with an honest
#   "illustration generation is not configured" message. No images are generated.
# local-openai-compatible: a self-hosted image server exposing the OpenAI Images
#   API (POST {IMAGE_BASE_URL}/images/generations). IMAGE_API_KEY is optional and
#   is only sent when set. See Setup.md for server, license, and hardware notes.
# openai-compatible: a hosted/key-protected OpenAI Images-compatible endpoint.
#   All three values below are required; hosted calls may cost money per image.
IMAGE_PROVIDER=disabled
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
