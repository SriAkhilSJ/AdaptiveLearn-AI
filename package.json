{
  "name": "adaptivelearn-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --serve-static",
    "preview": "npm run start",
    "test": "node --test server/*.test.mjs server/services/*.test.mjs server/providers/*.test.mjs src/lib/*.test.mjs",
    "lint": "oxlint",
    "dev:audio-agent": "node --env-file-if-exists=.env server/audio-agent.mjs dev",
    "start:audio-agent": "node --env-file-if-exists=.env server/audio-agent.mjs start"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-deepgram": "^1.9.1",
    "@livekit/agents-plugin-openai": "^1.9.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
